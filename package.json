{
  "name": "nestql",
  "version": "1.1.3",
  "description": "A lightweight utility library for extracting and transforming prefixed keys from flat objects into organized nested structures with customizable casing.",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.cjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "sql",
    "mapper",
    "data-transform",
    "nested",
    "flat-to-nested",
    "object-mapper",
    "typescript",
    "utility",
    "orm",
    "query-transform",
    "casing",
    "data-mapper"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "dev": "node src/index.ts",
    "start": "node dist/index.cjs",
    "build": "tsup"
  },
  "type": "module",
  "author": {
    "name": "Paris Liam",
    "email": "parissrowlet@gmail.com",
    "url": "https://github.com/kalachuuchiiii"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "jest": "30.3.0",
    "ts-jest": "29.4.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@10.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalachuuchiiii/nestql.git"
  },
  "bugs": {
    "url": "https://github.com/kalachuuchiiii/nestql/issues"
  },
  "homepage": "https://github.com/kalachuuchiiii/nestql#nestql"
}
